# Base de dados
DATABASE_URL="postgresql://user:password@localhost:5432/aqui?schema=public"

# URL pública do site (usada em emails, Stripe e sitemap)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Sessões (magic link + admin). Gerar com: openssl rand -base64 32
AUTH_SECRET="troque-isto-por-um-segredo-longo"

# Painel admin
ADMIN_PASSWORD="troque-isto"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Storage: "local" (desenvolvimento) ou "vercel-blob" (produção).
# As duas variáveis têm de ter o mesmo valor.
STORAGE_DRIVER="local"
NEXT_PUBLIC_STORAGE_DRIVER="local"
BLOB_READ_WRITE_TOKEN=""

# Email (magic link). Sem chave, os links são impressos na consola.
RESEND_API_KEY=""
EMAIL_FROM="Aqui. <ola@exemplo.pt>"

# Notificações internas (ex.: alvo de visualizações atingido).
# Sem esta variável, a notificação fica apenas registada na consola.
INTERNAL_NOTIFICATIONS_EMAIL=""

# Meta Marketing API (Ads Insights). Ver README > Integração Meta Marketing API.
META_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID=""
META_GRAPH_API_VERSION="v21.0"

# Protege /api/cron/meta-sync. Gerar com: openssl rand -base64 24
CRON_SECRET=""
