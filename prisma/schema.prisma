generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  IN_REVIEW
  ACTIVE
  COMPLETED
  REJECTED
  REFUNDED
}

enum BillingFrequency {
  ONE_TIME
  MONTHLY
}

enum DeliveryCycleStatus {
  ACTIVE
  COMPLETED
}

// A/B test da secção de preços da landing page — ver `src/lib/experiments.ts`.
enum PricingVariant {
  A
  B
}

enum ExperimentEventType {
  PRICING_EXPOSED
  PRICING_CTA_CLICKED
  PRICING_TOGGLE_CHANGED
  CHECKOUT_STARTED
  PAYMENT_CLICKED
  STRIPE_SESSION_CREATED
}

// A/B test da headline do Hero da landing page — completamente independente
// do teste de preços (cookie, tabela de eventos e enums próprios). Ver
// `src/lib/hero-experiment.ts`.
enum HeroVariant {
  A
  B
}

enum HeroEventType {
  HERO_EXPOSED
  HERO_CTA_CLICKED
  CHECKOUT_STARTED
  PAYMENT_CLICKED
  STRIPE_SESSION_CREATED
}

// Experimento A/B/C das 3 landing pages de entrada de campanhas
// (`landing_page_v1`, ver `/go` em `middleware.ts`) — completamente
// independente dos testes de Preços/Hero acima (cookie, tabela de eventos e
// enums próprios). Ao contrário daqueles, a atribuição é por SESSÃO (cookie
// sem `Max-Age`, nunca sticky para sempre) em vez de por 30 dias — ver
// `src/lib/landing-experiment-constants.ts`.
enum LandingVariant {
  NORMAL
  SALES
  BLOG
}

enum LandingEventType {
  EXPOSURE
  PRICING_VIEW
  CTA_CLICKED
  PLAN_SELECTED
  CHECKOUT_STARTED
  PAYMENT_CLICKED
  STRIPE_SESSION_CREATED
}

// Estado técnico da própria Stripe Checkout Session — nunca confundir com
// `Order.status` (que é o estado de negócio da encomenda). Uma sessão
// EXPIRED não muda o status da encomenda: a Order continua PENDING_PAYMENT
// e pode voltar a gerar uma nova sessão.
enum StripeCheckoutStatus {
  CREATED
  EXPIRED
  COMPLETED
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  phone       String
  companyName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders     Order[]
  loginToken LoginToken[]
}

model Order {
  id                      String      @id @default(cuid())
  userId                  String
  visualizationsPurchased Int
  visualizationsDelivered Int         @default(0)
  zone                    String
  price                   Int
  stripeSessionId         String?     @unique
  stripePaymentIntentId   String?
  status                  OrderStatus @default(PENDING_PAYMENT)
  // Estado técnico da Checkout Session (CREATED/EXPIRED/COMPLETED) — ver
  // `StripeCheckoutStatus`. Independente de `status`.
  stripeCheckoutStatus    StripeCheckoutStatus @default(CREATED)
  proofUrl                String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  // Faturação — por defeito ONE_TIME cobre automaticamente encomendas
  // antigas, criadas antes de existir a opção mensal.
  billingFrequency     BillingFrequency @default(ONE_TIME)
  stripeCustomerId     String?
  stripeSubscriptionId String?          @unique
  // Espelha o estado da Subscription na Stripe (active/past_due/canceled/...).
  subscriptionStatus   String?
  cancelAtPeriodEnd    Boolean          @default(false)

  // Integração Meta Marketing API — associação automática pelo nome
  // esperado da campanha (ver `getExpectedMetaCampaignName`). A campanha é
  // sempre "principal" da Order (reutilizada em todos os ciclos mensais),
  // nunca por ciclo.
  metaCampaignId String?
  metaAdSetId    String?
  metaAdId       String?
  metaAdUrl      String?

  // Email "a sua campanha já está ativa" — continua ao nível da Order
  // (dispara uma única vez, na primeira associação, independentemente de
  // quantos ciclos de entrega a encomenda venha a ter).
  metaActivationEmailSentAt DateTime?

  // A/B test da secção de preços — variante atribuída no momento em que esta
  // encomenda foi criada (lida da cookie `pricing_variant`, nunca do body do
  // pedido). `null` cobre encomendas anteriores ao experimento. Tráfego de
  // debug/interno (`experiment_debug`) fica marcado para nunca entrar nos KPIs.
  pricingVariant         PricingVariant?
  pricingExperimentDebug Boolean         @default(false)

  // A/B test da headline do Hero — variante atribuída no momento em que esta
  // encomenda foi criada (lida da cookie `hero_variant`, nunca do body do
  // pedido). Independente de `pricingVariant`/`pricingExperimentDebug` acima
  // — os dois testes correm em simultâneo mas nunca se misturam.
  heroVariant         HeroVariant?
  heroExperimentDebug Boolean      @default(false)

  // Experimento A/B/C das landing pages (`landing_page_v1`) — variante da
  // SESSÃO em que esta encomenda foi criada (lida da cookie `landing_session`,
  // nunca do body do pedido). `null` cobre encomendas fora do experimento
  // (não vieram de `/go`, ou vieram antes desta feature existir). Representa
  // apenas a conversão "direta/de sessão" (ver `src/lib/landing-attribution.ts`
  // para first/last/any-touch, que olham para o histórico completo do
  // `visitorId`, não só para esta sessão).
  landingVariant           LandingVariant?
  landingExperimentDebug   Boolean         @default(false)
  landingSessionId         String?
  landingExperimentVisitId String?

  // Visitante anónimo (cookie `aqui_vid`) — snapshot no momento da encomenda.
  // Campo genérico (não é só do experimento de landing): é o que permite
  // reconstruir first-touch/last-touch/assisted ao ligar esta Order ao
  // histórico de `LandingExperimentEvent` do mesmo visitante, mesmo que a
  // exposição relevante tenha acontecido numa sessão/dia diferente.
  visitorId String?

  // Meta Pixel + Conversions API — capturados em `/api/pedido` (único
  // momento em que temos o pedido real do browser do cliente; o webhook da
  // Stripe não tem acesso aos cookies/IP de quem pagou). `metaPurchaseEventId`
  // é partilhado entre o Pixel (em `/checkout/sucesso`) e a CAPI (no webhook)
  // para o 1º pagamento — dedup da Meta é por (event_name, event_id), por
  // isso o mesmo id serve tanto para `Purchase` como para `Subscribe`.
  // `metaClientIp` guarda o IP real de quem fez o pedido (nunca o IP dos
  // servidores da Stripe, que o webhook nunca vê) — passou a ser guardado
  // porque é um dos parâmetros de maior impacto na Event Match Quality
  // (ver README > Meta Pixel + Conversions API > Event Match Quality).
  metaPurchaseEventId String?
  metaFbp             String?
  metaFbc             String?
  metaClientUserAgent String?
  metaClientIp        String?
  // Consentimento de marketing (cookie `aqui_consent`) no momento em que o
  // pedido foi criado. Sem consentimento, o webhook nunca envia Purchase/
  // Subscribe para a Meta para esta encomenda — nem no 1º pagamento, nem em
  // renovações — independentemente de mais tarde vir a haver consentimento.
  metaMarketingConsent Boolean @default(false)

  // Atribuição de marketing (de onde veio o cliente) — nunca confundir com os
  // campos `meta*` acima, que são a campanha que a PRÓPRIA Aqui. cria/gere na
  // Meta Ads para entregar as visualizações compradas. Estes aqui são o
  // "snapshot" first-touch dos parâmetros vindos do anúncio que trouxe o
  // visitante (UTMs + IDs de campanha/adset/anúncio Meta), capturados no
  // `middleware.ts` (cookie `aqui_attribution`) e gravados aqui no momento em
  // que a Order é criada — nunca lidos do body do pedido nem recalculados
  // depois. Todos `null` em encomendas orgânicas/antigas ou sem atribuição.
  utmSource             String?
  utmMedium             String?
  utmCampaign           String?
  utmContent            String?
  utmTerm               String?
  placement             String?
  attributionCampaignId String?
  attributionAdsetId    String?
  attributionAdId       String?

  // Last paid touch — snapshot da ÚLTIMA visita com evidência clara de
  // campanha paga antes da criação da Order (ver regra `isPaidTouch` em
  // `src/lib/attribution-constants.ts`). Complementa, sem substituir, os 9
  // campos first-touch acima: aqueles respondem "de onde veio o cliente pela
  // primeira vez" (análise de aquisição), estes respondem "que campanha paga
  // o convenceu a comprar desta vez" (otimização de spend em Ads). Uma
  // visita direta/orgânica NUNCA apaga estes campos — só uma nova visita paga
  // os substitui. Todos `null` em encomendas sem nenhum toque pago
  // identificável (incluindo todas as Orders anteriores a esta feature).
  lastPaidUtmSource     String?
  lastPaidUtmMedium     String?
  lastPaidUtmCampaign   String?
  lastPaidUtmContent    String?
  lastPaidUtmTerm       String?
  lastPaidPlacement     String?
  lastPaidCampaignId    String?
  lastPaidAdsetId       String?
  lastPaidAdId          String?

  // --- Histórico anterior aos DeliveryCycle — mantidos apenas para não
  // perder dados de encomendas antigas (criadas antes desta migration). O
  // código novo lê/escreve exclusivamente nos campos equivalentes do
  // `DeliveryCycle`; não usar estes campos em código novo.
  targetReachedAt       DateTime?
  metaPausedAt          DateTime?
  metaPauseReason       String?
  metaPauseLastError    String?
  completionEmailSentAt DateTime?
  nearTargetNotifiedAt  DateTime?

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets  Asset[]
  updates CampaignUpdate[]
  cycles  DeliveryCycle[]

  @@index([userId])
  @@index([status])
  @@index([metaAdId])
  @@index([pricingVariant])
  @@index([heroVariant])
  @@index([landingVariant])
  @@index([visitorId])
}

/**
 * Um ciclo de entrega representa UMA janela de entrega de visualizações:
 * a totalidade de uma encomenda ONE_TIME, ou UM mês de uma subscrição
 * MONTHLY. A mesma campanha Meta (`Order.metaCampaignId`) é reutilizada em
 * todos os ciclos — cada ciclo só controla o seu próprio alvo/entrega.
 */
model DeliveryCycle {
  id             String              @id @default(cuid())
  orderId        String
  targetViews    Int
  deliveredViews Int                 @default(0)
  startsAt       DateTime
  endsAt         DateTime
  status         DeliveryCycleStatus @default(ACTIVE)

  targetReachedAt DateTime?
  completedAt     DateTime?

  // Pausa/reativação da campanha Meta para este ciclo específico.
  metaPausedAt       DateTime?
  metaPauseReason    String?
  metaPauseLastError String?
  metaResumedAt      DateTime?

  // Cada um destes "*At" garante que a respetiva ação (alerta, email) só
  // acontece UMA VEZ por ciclo.
  nearTargetNotifiedAt  DateTime?
  completionEmailSentAt DateTime?

  // Idempotência: um `invoice.paid` da Stripe nunca cria dois ciclos.
  stripeInvoiceId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  updates CampaignUpdate[]

  @@index([orderId])
  @@index([status])
}

model Asset {
  id        String   @id @default(cuid())
  orderId   String
  fileUrl   String
  fileType  String
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model CampaignUpdate {
  id                      String   @id @default(cuid())
  orderId                 String
  cycleId                 String?
  visualizationsDelivered Int
  createdAt               DateTime @default(now())

  order Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cycle DeliveryCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([cycleId])
}

/**
 * Pares chave/valor simples para configurações globais (ex.: última sincronização Meta).
 */
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/**
 * Eventos do funil do A/B test de preços que acontecem ANTES de existir uma
 * `Order` (exposição, clique no CTA, mudança do toggle, chegada ao checkout).
 * Eventos financeiros (`order_created`/`payment_completed`) não são gravados
 * aqui — lêem-se sempre da própria `Order`/Stripe, nunca do cliente.
 */
model ExperimentEvent {
  id        String              @id @default(cuid())
  visitorId String
  variant   PricingVariant
  eventType ExperimentEventType
  metadata  Json?
  isDebug   Boolean             @default(false)
  createdAt DateTime            @default(now())

  @@index([variant, eventType])
  @@index([visitorId])
}

/**
 * Eventos do funil do A/B test da headline do Hero — tabela própria (nunca
 * partilhada com `ExperimentEvent`, do teste de preços) para que os dois
 * testes possam correr ao mesmo tempo sem se misturarem. Mesma forma e
 * mesmas garantias: `visitorId` vem sempre da cookie `aqui_vid` (partilhada
 * entre os dois testes, só para identificar visitantes), `variant` vem
 * sempre da cookie `hero_variant`/`hero_debug` — nunca do cliente.
 */
model HeroExperimentEvent {
  id        String        @id @default(cuid())
  visitorId String
  variant   HeroVariant
  eventType HeroEventType
  metadata  Json?
  isDebug   Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([variant, eventType])
  @@index([visitorId])
}

/**
 * Eventos do funil do experimento A/B/C das landing pages (`landing_page_v1`)
 * — tabela própria (nunca partilhada com `ExperimentEvent`/`HeroExperimentEvent`)
 * para que os três testes corram ao mesmo tempo sem se misturarem. Duas
 * diferenças face aos outros: `sessionId` e `experimentVisitId`, necessários
 * para reconstruir jornadas entre sessões (ver `src/lib/landing-attribution.ts`)
 * — os testes de Preços/Hero são sticky 30 dias e não precisam disto.
 * `visitorId` continua a vir sempre da cookie `aqui_vid` (partilhada por
 * todos os experimentos, só identifica o visitante).
 */
model LandingExperimentEvent {
  id                String           @id @default(cuid())
  visitorId         String
  sessionId         String
  experimentVisitId String
  variant           LandingVariant
  eventType         LandingEventType
  metadata          Json?
  isDebug           Boolean          @default(false)
  createdAt         DateTime         @default(now())

  @@index([variant, eventType])
  @@index([visitorId])
  @@index([experimentVisitId])
}

model LoginToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
